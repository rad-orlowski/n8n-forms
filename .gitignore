# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Env — real secrets stay local, only the example is committed
.env
.env.*.local
!.env.example

# BFF session store (bun:sqlite) — runtime state, never committed
sessions.db
sessions.db-shm
sessions.db-wal

# Build output — inlined webhook URLs must not be committed
bundle.html
forms.html

# Test coverage reports (generated by `bun run test:coverage`)
coverage/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Playwright MCP — screenshots, snapshots, console logs
.playwright-mcp/

# AI Coding
CLAUDE.md
AGENTS.md
.claude/
skills-lock.json

# User forms — personal definitions stay local; ping + the public examples are tracked.
# Exclude the dir *contents* (not the dir itself) so subpaths can be re-included.
/forms/*
!/forms/ping.form.ts
!/forms/examples/
!/forms/form.schema.json

# Local-only working directories
.superpowers/
/docs
!/docs/adr/