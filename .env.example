# Server-side runtime secrets for the n8n-forms BFF server.
#
# IMPORTANT: These are NOT inlined into the client bundle — they are read by the
# Hono/Bun server process at startup. Keep real values out of git by setting them
# only in a local `.env` file (gitignored). Never share or commit this file with
# real secrets filled in.
#
# Copy this file to `.env`, fill in real values, then run `bun start`.
#
# Naming convention: WEBHOOK_<SLUG>, where SLUG is the form's slug uppercased
# with non-alphanumeric characters replaced by _.
# e.g. "event-rsvp" -> WEBHOOK_EVENT_RSVP

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3737
PUBLIC_BASE_URL=http://localhost:3737
# Show the bundled example/demo forms (everything under forms/examples/) in the
# console. Default is true. Set to false to hide them without deleting the
# example definitions. Exposed to the SPA via GET /api/config (no secret).
# SHOW_EXAMPLE_FORMS=true
# Optional: path to a PEM CA cert for local n8n instances using self-signed /
# mkcert TLS. Leave unset when n8n has a real certificate. Example:
#   NODE_EXTRA_CA_CERTS=$(mkcert -CAROOT)/rootCA.pem
# NODE_EXTRA_CA_CERTS=

# ── ping ─────────────────────────────────────────────────────────────────────
WEBHOOK_PING=https://YOUR-N8N-HOST/webhook/ping

# ── contact ──────────────────────────────────────────────────────────────────
WEBHOOK_CONTACT=https://YOUR-N8N-HOST/webhook/contact

# ── feedback ─────────────────────────────────────────────────────────────────
WEBHOOK_FEEDBACK=https://YOUR-N8N-HOST/webhook/feedback

# ── event-rsvp ───────────────────────────────────────────────────────────────
WEBHOOK_EVENT_RSVP=https://YOUR-N8N-HOST/webhook/event-rsvp

# ── wizard-demo ───────────────────────────────────────────────────────────────
WEBHOOK_WIZARD_DEMO=https://YOUR-N8N-HOST/webhook/wizard-demo
