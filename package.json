  "scriptDescriptions": {
    "build": "Compile TypeScript + bundle SPA → `dist/`",
    "dev": "Single dev server: Hono BFF + Vite middleware at `http://localhost:3737` (HMR included)",
    "dev:vite": "Vite standalone at `http://localhost:5173` (SPA only, no BFF)",
    "docs:generate": "Regenerate autogenerated sections in all markdown files",
    "lint": "Run ESLint across all source files",
    "preview": "Preview the Vite production build locally",
    "start": "Serve `dist/` + `/api/*` via the Hono BFF (production)",
