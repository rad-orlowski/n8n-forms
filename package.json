    "dev": "bun --watch src/server/dev.ts",
    "dev:vite": "vite",
    "docs:generate": "md-magic --files '**/*.md' --config ./markdown.config.cjs && md-magic --files '.claude/**/*.md' --config ./markdown.config.cjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "bun src/server/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
