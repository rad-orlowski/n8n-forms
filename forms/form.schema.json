{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "pages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "resumeUrlPath": {
            "type": "string"
          },
          "submitLabel": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST"
            ]
          },
          "timeoutMs": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "const": "indefinite"
              }
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "placeholder": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "label",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                },
                "optionsFrom": {
                  "type": "string"
                },
                "valueFrom": {
                  "type": "string"
                },
                "optionLabel": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "optionValue": {
                  "type": "string"
                },
                "valueFromField": {
                  "type": "string"
                },
                "visibleIf": {
                  "type": "string"
                },
                "requiredIf": {
                  "type": "string"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "content": {
                  "type": "string"
                },
                "src": {
                  "type": "string"
                },
                "variant": {
                  "type": "string",
                  "enum": [
                    "info",
                    "warning",
                    "danger",
                    "success"
                  ]
                },
                "level": {
                  "anyOf": [
                    {
                      "type": "number",
                      "const": 2
                    },
                    {
                      "type": "number",
                      "const": 3
                    }
                  ]
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "fields"
        ],
        "additionalProperties": false
      }
    },
    "submitLabel": {
      "type": "string"
    },
    "timeoutMs": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "const": "indefinite"
        }
      ]
    },
    "response": {
      "type": "object",
      "properties": {
        "header": {
          "type": "object",
          "properties": {
            "style": {
              "type": "string",
              "enum": [
                "compact",
                "full",
                "none"
              ]
            },
            "heading": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "format": {
                "type": "string",
                "enum": [
                  "heading",
                  "tags",
                  "list",
                  "transcript",
                  "copy"
                ]
              },
              "prose": {
                "type": "boolean"
              },
              "section": {
                "type": "string"
              },
              "hideIfEmpty": {
                "type": "boolean"
              }
            },
            "required": [
              "key"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "slug",
    "title",
    "pages"
  ],
  "additionalProperties": false
}
