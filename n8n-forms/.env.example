# Webhook URLs for the n8n form console.
#
# IMPORTANT: Vite inlines these values into the built bundle at build time — they
# are NOT runtime secrets. Anyone with the bundle.html can read them. Keep real
# URLs out of git by setting them only in a local `.env` file (gitignored).
#
# Copy this file to `.env`, fill in real values, then run `bun run build`.

VITE_WEBHOOK_CONTACT=https://YOUR-N8N-HOST/webhook/contact
VITE_WEBHOOK_BUG_REPORT=https://YOUR-N8N-HOST/webhook/bug-report
VITE_WEBHOOK_PING=https://YOUR-N8N-HOST/webhook/ping
